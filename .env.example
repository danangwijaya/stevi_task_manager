# ==============================================================================
# STEVI Task Manager - Production Environment Variables Template
# Salin file ini menjadi `.env` di root proyek sebelum menjalankan docker compose:
# cp .env.example .env
# --- PORT WEB / FRONTEND (Port publik VPS) ---
# Port standar 80 untuk akses langsung domain / IP tanpa port
FRONTEND_PORT=80


# --- DATABASE CONFIGURATION (PostgreSQL + PostGIS) ---
POSTGRES_USER=geoai_user
POSTGRES_PASSWORD=ganti_dengan_password_database_yang_kuat_2026
POSTGRES_DB=geoai_landcover
POSTGRES_PORT=5432

# URL koneksi internal untuk docker-compose
DATABASE_URL=postgresql://geoai_user:ganti_dengan_password_database_yang_kuat_2026@postgis:5432/geoai_landcover

# --- SECURITY & JWT AUTHENTICATION ---
# Buat string acak minimal 32 karakter (misal via `openssl rand -hex 32`)
SECRET_KEY=ganti_dengan_jwt_secret_key_yang_sangat_rahasia_dan_panjang_32char
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- INITIAL ADMINISTRATOR ACCOUNT (Auto-Seeded on First Run) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@stevi.id
INITIAL_ADMIN_PASSWORD=ganti_dengan_password_admin_yang_aman

# --- GOOGLE EARTH ENGINE (Opsional - Jika Menggunakan GEE API Langsung) ---
GEE_SERVICE_ACCOUNT=
GEE_PROJECT_ID=
GEE_PRIVATE_KEY_PATH=

# --- EXPORT & STORAGE CONFIGURATION ---
EXPORT_DIR=/app/exports
PATCH_SIZE_PIXELS=1024
PIXEL_RESOLUTION_METERS=10.0
