# Database Connection (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/geoai_landcover

# Security Secret Key
SECRET_KEY=change_this_to_a_secure_random_key_for_production_use

# Absolute path to folder containing Sentinel-2 GeoTIFF composites
RASTER_BASE_DIR=/var/www/training-sample/backend/data/raster
